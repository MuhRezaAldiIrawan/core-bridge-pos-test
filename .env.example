# ============================================================
# Core Bridge POS - Environment Configuration
# ============================================================

# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_DIR=storage/logs
LOG_ENABLE_CONSOLE=true

# ============================================================
# MySQL
# ============================================================
# Connection URL - format: mysql://user:pass@host:port/dbname
DATABASE_URL=mysql://core_bridge:mysqlpassword123!@localhost:3306/core_bridge_db
MYSQL_DATABASE=core_bridge_db
MYSQL_USER=core_bridge
MYSQL_PASSWORD=mysqlpassword123!
MYSQL_ROOT_PASSWORD=rootpassword123!

# ============================================================
# RabbitMQ
# ============================================================
RABBITMQ_URL=amqp://admin:dbpassword123@localhost:5672


# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_TTL=60          # Window dalam detik (default: 60 detik)
RATE_LIMIT_LIMIT=300       # Max request per window (default: 300)

# ============================================================
# Webhook Configuration
# ============================================================
WEBHOOK_TIMEOUT_MS=10000    # Timeout dalam milidetik (default: 10 detik)
WEBHOOK_RETRY_DELAYS=5000,15000,45000  # Delay antar retry dalam ms
WEBHOOK_MAX_RETRIES=3       # Max jumlah retry

# ============================================================
# Redis
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=         

# ============================================================
# Security
# ============================================================
allowedOrigins=http://localhost:3000   # NOTE: lowercase 'a' di 'allowedOrigins'
TRUST_PROXY=true
