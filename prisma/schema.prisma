// Prisma schema for Core Bridge POS
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// Entity 1: Application
// ============================================
model Application {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  type          String // REQUESTER | PROCESSOR
  apiKey        String   @unique @map("api_key")
  webhookSecret String?  @map("webhook_secret")
  isActive      Boolean  @default(true) @map("is_active")
  allowedIps    Json     @default("[]") @map("allowed_ips")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  requesterTransactions Transaction[] @relation("RequesterApplication")
  processorTransactions Transaction[] @relation("ProcessorApplication")

  @@index([code])
  @@index([apiKey])
  @@index([isActive])
  @@map("applications")
}

// ============================================
// Entity 2: Transaction
// ============================================
model Transaction {
  id                     String   @id @default(uuid())
  type                   String // CHECK_IN | CHECK_IMAGE
  applicationId          String   @map("application_id")
  processorCode          String   @map("processor_code")
  processorApplicationId String?  @map("processor_application_id")
  webhookUrl             String   @map("webhook_url")
  venueId                String   @map("venue_id")
  params                 Json
  status                 String // PENDING | PUBLISHED | SUCCESS | FAILED
  errorCode              String?  @map("error_code")
  errorMessage           String?  @map("error_message")
  retryCount             Int      @default(0) @map("retry_count")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  application          Application      @relation("RequesterApplication", fields: [applicationId], references: [id])
  processorApplication Application?     @relation("ProcessorApplication", fields: [processorApplicationId], references: [id])
  webhookLogs          WebhookLog[]
  transactionLogs      TransactionLog[]

  @@index([applicationId])
  @@index([processorApplicationId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

// ============================================
// Entity 3: WebhookLog
// ============================================
model WebhookLog {
  id             String      @id @default(uuid())
  transactionId  String      @map("transaction_id")
  url            String
  requestPayload Json?       @map("request_payload")
  httpStatus     Int?        @map("http_status")
  responseBody   String?     @map("response_body")
  status         String // PENDING | SUCCESS | FAILED
  attempt        Int         @default(1) // Attempt number
  errorMessage   String?     @map("error_message")
  latencyMs      Int?        @map("latency_ms")
  sentAt         DateTime    @default(now()) @map("sent_at")
  completedAt    DateTime?   @map("completed_at")
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([status])
  @@index([attempt])
  @@map("webhook_logs")
}

// Entity 4: TransactionLog (Audit Trail)
model TransactionLog {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  status        String
  action        String
  details       Json?
  errorCode     String?  @map("error_code")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([status])
  @@index([createdAt])
  @@map("transaction_logs")
}
